# Reverse proxy HTTPS (Caddy, https://caddyserver.com) davanti a SENAITE/Zope (VirtualHostMonster)
{$SENAITE_DOMAIN} {
	rewrite * /VirtualHostBase/https/{$SENAITE_DOMAIN}:443/senaite/VirtualHostRoot{uri}
	reverse_proxy instance:8080
}
