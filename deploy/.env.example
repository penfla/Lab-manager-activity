# Copiare in .env (install.ps1 lo fa e genera la password).
SENAITE_VERSION=v2.6.0
SENAITE_ADMIN_PASSWORD=CAMBIAMI
SENAITE_PORT=8080
# 0.0.0.0 = accessibile dalla LAN; 127.0.0.1 = solo locale (usare con docker-compose.cloud.yml)
SENAITE_BIND=0.0.0.0
SENAITE_MEM_LIMIT=2048M
# Cartella destinazione backup: percorso locale, UNC (\\server\share\senaite) o cartella sincronizzata OneDrive/SharePoint
BACKUP_DIR=C:\SenaiteBackup
BACKUP_KEEP=14
# Solo cloud (docker-compose.cloud.yml): dominio pubblico per HTTPS Let's Encrypt
SENAITE_DOMAIN=lims.example.com
